# Database
DATABASE_URL="postgresql://geotech:geotech@localhost:5432/geotech?schema=public"

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Authentication — generate a strong random value per environment.
# Never commit a real secret.
JWT_SECRET="change-me-in-every-environment"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Session policy — set to the mine IT policy (§31)
SESSION_IDLE_TIMEOUT_MINUTES=60
# How long a device may keep capturing underground without reaching the server
OFFLINE_GRANT_HOURS=16

# Site prefix used when minting record identifiers, e.g. UNK-FL-2026-000124
SITE_CODE="UNK"

# Object storage for face photographs
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
